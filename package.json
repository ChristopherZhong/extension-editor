{
  "name": "local-llm-extension",
  "version": "1.0.0",
  "description": "Local LLM browser extension providing Grammarly alternative writing assistance powered by Ollama",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "lit": "^3.2.1",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.0",
    "@types/node": "^22.13.9",
    "@types/webextension-polyfill": "^0.12.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7",
    "wxt": "^0.19.28"
  }
}
